# New file - added alongside your existing PDF extraction file, not
# merged into it. This is a FastAPI *router*, not its own app - Render
# only runs one app object per service, so this needs to be mounted
# onto your existing app with two lines (shown in main.py), rather
# than being a second, separately-running FastAPI() instance that
# would never actually get served.
#
# Uses easyocr rather than pytesseract - pytesseract needs a separate
# system program (tesseract) installed on the machine itself, which
# Render's standard Python environment cannot do (apt-get fails there
# with a read-only filesystem error). easyocr installs entirely
# through pip, avoiding that problem completely, at the cost of a
# larger download and higher memory use on first load.
#
# Never overwrites vote_counts (the watcher's own entry, which stays
# authoritative). Only ever writes to the separate ocr_* columns,
# flagging a discrepancy ONLY when OCR confidently recognized a real
# candidate name AND its number disagrees with what was typed - never
# flags a candidate OCR couldn't confidently read at all.
#
# Requirements.txt needs: easyocr, opencv-python-headless, numpy, requests
# (remove pytesseract - no longer used)
#
# --- In your EXISTING main.py, these two lines should already be there: ---
#   from er_ocr_endpoint import router as ocr_router
#   app.include_router(ocr_router)

import difflib
import re

import cv2
import numpy as np
import requests
from fastapi import APIRouter
from pydantic import BaseModel

router = APIRouter()

# Loaded once, reused across requests - loading this fresh on every
# call would be extremely slow. First request after a deploy will be
# slow while this initial load happens; subsequent ones are fast.
import easyocr
_reader = easyocr.Reader(['en'], gpu=False)


class OcrRequest(BaseModel):
    image_url: str
    candidate_names: list[str]


def preprocess_image(image_bytes: bytes) -> np.ndarray:
    """Grayscale and contrast boost - a real phone photo of a printed
    ER has uneven lighting and glare that raw OCR handles poorly
    without this."""
    arr = np.frombuffer(image_bytes, dtype=np.uint8)
    img = cv2.imdecode(arr, cv2.IMREAD_COLOR)
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    return clahe.apply(gray)


def fuzzy_match_name(text: str, candidate_names: list[str]) -> str | None:
    """OCR will introduce minor character errors in names - fuzzy
    matching against the REAL, known candidate list (not guessing at
    arbitrary text) keeps this safe: it can only ever "recognize" a
    name that's genuinely in the database, never invent one."""
    text_upper = text.upper().strip()
    matches = difflib.get_close_matches(text_upper, candidate_names, n=1, cutoff=0.75)
    return matches[0] if matches else None


def group_into_rows(ocr_results, y_tolerance: int = 15) -> list[list]:
    """easyocr returns each detected text block with its own bounding
    box, not pre-joined lines - this groups blocks that share roughly
    the same vertical position back into a single row, since the ER's
    layout puts a candidate's name and vote count side by side on one
    printed line."""
    rows: list[list] = []
    for bbox, text, confidence in ocr_results:
        y_center = (bbox[0][1] + bbox[2][1]) / 2
        placed = False
        for row in rows:
            row_y = row[0][3]
            if abs(row_y - y_center) < y_tolerance:
                row.append((bbox[0][0], text, confidence, y_center))
                placed = True
                break
        if not placed:
            rows.append([(bbox[0][0], text, confidence, y_center)])
    for row in rows:
        row.sort(key=lambda item: item[0])  # left to right within the row
    return rows


@router.post("/extract-er-ocr")
def extract_er_ocr(req: OcrRequest):
    try:
        resp = requests.get(req.image_url, timeout=20)
        resp.raise_for_status()
    except Exception as e:
        return {"status": "failed", "error": f"Could not download image: {e}"}

    try:
        processed = preprocess_image(resp.content)
        ocr_results = _reader.readtext(processed)
    except Exception as e:
        return {"status": "failed", "error": f"OCR processing failed: {e}"}

    rows = group_into_rows(ocr_results)

    extracted_votes: dict[str, int] = {}
    for row in rows:
        row_text = " ".join(item[1] for item in row)
        number_match = re.search(r"(\d{1,5})\s*$", row_text.strip())
        if not number_match:
            continue
        name_part = row_text[: number_match.start()].strip()
        matched_name = fuzzy_match_name(name_part, req.candidate_names)
        if matched_name and matched_name not in extracted_votes:
            extracted_votes[matched_name] = int(number_match.group(1))

    return {
        "status": "completed",
        "extracted_votes": extracted_votes,
        "candidates_recognized": len(extracted_votes),
        "candidates_expected": len(req.candidate_names),
    }
